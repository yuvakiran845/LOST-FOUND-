# ─── Server ──────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers → copy the URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusconnect?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# Use a long, random string. Example: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────
# Get from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Client ───────────────────────────────────────────────
# URL of the React frontend (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# ─── Email (Nodemailer) ───────────────────────────────────
# Optional — if not set, emails are silently skipped (app still works)
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# EMAIL_SERVICE defaults to 'gmail' if not set
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Admin ────────────────────────────────────────────────
# Comma-separated list of emails that have admin access
# Example: admin@college.edu,yourname@gmail.com
ADMIN_EMAILS=admin@college.edu
